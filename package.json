{
  "name": "@reintersect/agent-plugins",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "build": "pnpm -r build && tsx scripts/build.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm -r build && tsx scripts/build.ts --check",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
