  "description": "Reintersect for OpenCode: recall what your team knows, capture what you learn, and reach Reintersect's tools from OpenCode.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://reintersect.com",
  "repository": {
    "type": "git",
