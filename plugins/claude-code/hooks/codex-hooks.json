{
  "description": "Continuously recall task-relevant memory, restore context after compaction, and capture sessions durably.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/reintersect-agent.mjs\" hook claudeCode session-start",
            "timeout": 20,
            "statusMessage": "Recalling what Reintersect knows...",
            "async": true
          }
        ]
      },
      {
        "matcher": "resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/reintersect-agent.mjs\" hook claudeCode session-start",
            "timeout": 5,
            "statusMessage": "Recalling what Reintersect knows..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/reintersect-agent.mjs\" hook claudeCode user-prompt",
            "timeout": 6
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Read|SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/reintersect-agent.mjs\" hook claudeCode post-tool",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/reintersect-agent.mjs\" hook claudeCode background-recall",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/reintersect-agent.mjs\" hook claudeCode post-tool-failure",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/reintersect-agent.mjs\" hook claudeCode stop",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/reintersect-agent.mjs\" hook claudeCode subagent-stop",
            "timeout": 3
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/reintersect-agent.mjs\" hook claudeCode pre-compact",
            "timeout": 5,
            "statusMessage": "Saving this session to Reintersect..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/reintersect-agent.mjs\" hook claudeCode session-end",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/reintersect-agent.mjs\" hook claudeCode subagent-start",
            "timeout": 6
          }
        ]
      }
    ]
  }
}
